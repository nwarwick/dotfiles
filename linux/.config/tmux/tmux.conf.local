# Split in the current pane's directory with Ctrl-Space, then /, \, or -.
bind / split-window -h -c "#{pane_current_path}"
bind \\ split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# Navigate seamlessly between Neovim splits and tmux panes with Ctrl-h/j/k/l.
run-shell ~/.config/tmux/plugins/vim-tmux-navigator/vim-tmux-navigator.tmux
